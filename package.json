{
	"name": "pi-gitlab-duo",
	"private": true,
	"version": "0.1.0",
	"description": "GitLab Duo provider for pi, with /login (instance URL + PAT) against self-managed GitLab",
	"type": "module",
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "node --test test/",
		"smoke": "node smoke.ts",
		"install-ext": "node scripts/install.mjs"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	}
}
